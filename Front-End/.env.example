API_BASE_URL=http://127.0.0.1:8200
APP_BASE_URL=http://127.0.0.1:3200
APP_ENV=development
TRUST_CLOUDFLARE_HEADERS=false
# Optional authentication and cross-device sync. Guest/local mode works blank.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_AUTH_ENABLED=false
# Server-only token used by Next.js server actions to call the backend email
# orchestrator. Never prefix this variable with NEXT_PUBLIC_.
EMAIL_INTERNAL_API_TOKEN=

# Optional public logo token. Never place SUPABASE_SECRET_KEY,
# SMTP_PASSWORD, RESEND_API_KEY, or a Google client secret in the frontend environment.
NEXT_PUBLIC_LOGO_DEV_TOKEN=
