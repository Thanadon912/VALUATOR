ENABLE_LIVE_PROVIDERS=true
PERFORMANCE_CACHE_ONLY_ENABLED=false
SEC_USER_AGENT=USAStockAnalysis your-email@example.com
FRED_API_KEY=
FMP_API_KEY=
# Optional provider/news cache. Leave both values blank to run without Supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Used only by the local Supabase integration test; backend runtime code does
# not need the publishable key.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TIMEOUT_SECONDS=5
PROVIDER_TIMEOUT_SECONDS=8
SUPPLY_CHAIN_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_SUPPLY_CHAIN_MODEL=gemini-3.1-flash-lite
SUPPLY_CHAIN_CACHE_DIR=Back-End/.cache/supply_chain
CUSTOMER_MIX_AI_ENABLED=true
GEMINI_CUSTOMER_MIX_PRIMARY_MODEL=gemini-3.1-flash-lite
GEMINI_CUSTOMER_MIX_SECONDARY_MODEL=gemini-2.5-flash-lite
CUSTOMER_MIX_AI_RATE_LIMIT_COOLDOWN_SECONDS=300
CUSTOMER_MIX_CACHE_DIR=Back-End/.cache/customer_mix
SEC_13F_CACHE_DIR=Back-End/.cache/13f
SEC_13F_DATABASE_PATH=Back-End/.cache/13f/latest.sqlite3
SEC_13F_MAPPING_FILE=Back-End/config/security_identifier_mappings.json
# Public API security controls. Keep CORS empty unless a browser client needs
# cross-origin access; non-browser API clients are unaffected by CORS.
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
API_RATE_LIMIT_ENABLED=true
API_GENERAL_RATE_PER_MINUTE=120
API_MARKET_RATE_PER_MINUTE=30
API_VALUATION_RATE_PER_MINUTE=20
API_DCF_RATE_PER_MINUTE=6
API_AUTH_EMAIL_RATE_PER_MINUTE=10
API_DCF_CONCURRENCY=2
API_PROVIDER_CONCURRENCY=8

# Server-only transactional email. Keep disabled in CI and never commit real
# values. Set EMAIL_PROVIDER=gmail_smtp to use Gmail with an App Password.
# Optional legacy override. Leave blank when EMAIL_PROVIDER is set.
EMAIL_DELIVERY_MODE=
EMAIL_PROVIDER=
EMAIL_INTERNAL_API_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=VALUATOR
EMAIL_REPLY_TO=
SMTP_TIMEOUT_SECONDS=10
# Legacy Resend provider. resend_test only sends to the account owner.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VALUATOR <onboarding@resend.dev>
RESEND_TEST_RECIPIENT=
RESEND_REPLY_TO=
RESEND_TIMEOUT_SECONDS=5
APP_BASE_URL=http://127.0.0.1:3200
