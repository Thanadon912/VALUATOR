import com.cloudbees.plugins.credentials.CredentialsProvider
import com.cloudbees.plugins.credentials.CredentialsScope
import com.cloudbees.plugins.credentials.SecretBytes
import com.cloudbees.plugins.credentials.SystemCredentialsProvider
import com.cloudbees.plugins.credentials.domains.Domain
import jenkins.model.Jenkins
import org.jenkinsci.plugins.plaincredentials.FileCredentials
import org.jenkinsci.plugins.plaincredentials.impl.FileCredentialsImpl
import org.jenkinsci.plugins.plaincredentials.StringCredentials
import org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl
import hudson.util.Secret

def encodedRuntimeEnv = "__VALUATOR_RUNTIME_ENV_BASE64__"
def decodedRuntimeEnv = Base64.decoder.decode(encodedRuntimeEnv)
def encodedVercelToken = "__VERCEL_TOKEN_BASE64__"
def decodedVercelToken = new String(Base64.decoder.decode(encodedVercelToken), "UTF-8")
def store = SystemCredentialsProvider.getInstance().getStore()

def upsertFile = { String credentialId, String fileName, String description ->
  def existing = CredentialsProvider.lookupCredentials(
    FileCredentials.class,
    Jenkins.get()
  ).find { credential -> credential.id == credentialId }

  def replacement = new FileCredentialsImpl(
    CredentialsScope.GLOBAL,
    credentialId,
    description,
    fileName,
    SecretBytes.fromBytes(decodedRuntimeEnv)
  )

  if (existing == null) {
    if (!store.addCredentials(Domain.global(), replacement)) {
      throw new IllegalStateException("Jenkins did not add credential: ${credentialId}")
    }
    println("Created runtime Secret File credential: ${credentialId}")
    return
  }

  if (!store.updateCredentials(Domain.global(), existing, replacement)) {
    throw new IllegalStateException("Jenkins did not update credential: ${credentialId}")
  }
  println("Updated runtime Secret File credential: ${credentialId}")
}

def upsertToken = { String credentialId, String description ->
  def existing = CredentialsProvider.lookupCredentials(
    StringCredentials.class,
    Jenkins.get()
  ).find { credential -> credential.id == credentialId }
  def replacement = new StringCredentialsImpl(
    CredentialsScope.GLOBAL,
    credentialId,
    description,
    Secret.fromString(decodedVercelToken)
  )

  if (existing == null) {
    if (!store.addCredentials(Domain.global(), replacement)) {
      throw new IllegalStateException("Jenkins did not add credential: ${credentialId}")
    }
    println("Created Secret Text credential: ${credentialId}")
    return
  }

  if (!store.updateCredentials(Domain.global(), existing, replacement)) {
    throw new IllegalStateException("Jenkins did not update credential: ${credentialId}")
  }
  println("Updated Secret Text credential: ${credentialId}")
}

upsertFile(
  "valuator-staging-env",
  "valuator-staging.env",
  "VALUATOR staging and live-provider runtime environment"
)
upsertFile(
  "valuator-production-env",
  "valuator-production.env",
  "VALUATOR production runtime and deployment environment"
)
upsertToken(
  "vercel-api-token",
  "Vercel API token for Jenkins-gated production deployment"
)
println("Jenkins production credentials are ready")
