# Runtime mode and public provider configuration
ENABLE_LIVE_PROVIDERS=true
PERFORMANCE_CACHE_ONLY_ENABLED=false
SEC_USER_AGENT=USAStockAnalysis contact@example.com
PROVIDER_TIMEOUT_SECONDS=8

# Optional market-data and AI provider credentials
FRED_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
GEMINI_API_KEY=
ALPHA_VANTAGE_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional Supabase persistence and authentication. Core market-data and
# valuation routes work without these values. The secret is injected only into
# the backend; the publishable key is the only key exposed to the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TIMEOUT_SECONDS=5

# Frontend authentication URLs and feature flags
FRONTEND_PORT=3200
BACKEND_PORT=8200
APP_BASE_URL=http://127.0.0.1:3200
GOOGLE_AUTH_ENABLED=false

# Optional Logo.dev publishable key. Docker Compose injects this into the
# frontend build; this is a public browser token, not a server secret.
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Local Supabase Google provider configuration. These remain server-only and
# must never be prefixed with NEXT_PUBLIC_ or injected into the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deployment automation (local bootstrap or Jenkins credentials only; never
# expose these values to either Vercel runtime project).
VERCEL_ACCESS_TOKEN=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
RESEND_TEST_RECIPIENT=
